name = "00food-api"
main = "src/index.ts"
compatibility_date = "2026-09-27"
workers_dev = false
preview_urls = false

[vars]
APP_NAME = "00Food"
PUBLIC_ORIGIN = "https://api.example.com"
APPLE_APP_CLIENT_ID = "com.example.zerozerofood"
APPLE_WEB_CLIENT_ID = "com.example.zerozerofood.signin"
APPLE_WEB_REDIRECT_URI = "https://api.example.com/auth/apple/callback"
APPLE_TEAM_ID = "REPLACE_WITH_APPLE_TEAM_ID"
APPLE_KEY_ID = "REPLACE_WITH_SIGN_IN_WITH_APPLE_KEY_ID"
MCP_VERIFIED_CLIENTS = '{"https://chatgpt.com/connector_platform_oauth_redirect":"ChatGPT"}'

# Optional: email the operator when Sign in with Apple creates a new tenant.
# Commented out because it requires Cloudflare Email Routing on a domain in
# your account, and an uncommented binding would fail `wrangler deploy` for
# anyone who has not set that up.
#
# The destination address must be a verified Email Routing destination.
# [[send_email]]
# name = "SIGNUP_ALERTS"
# destination_address = "you@example.com"
#
# Then set the recipient (and optionally the sender, which must be on an
# Email Routing domain you control; it defaults to the recipient) under [vars]:
# SIGNUP_ALERT_TO = "you@example.com"
# SIGNUP_ALERT_FROM = "alerts@example.com"

# Daily cleanup of expired OAuth flows, codes, credentials, subscriptions,
# and old food events (src/cleanup.ts). Uses one of the account's cron slots.
[triggers]
crons = ["17 3 * * *"]

[[routes]]
pattern = "api.example.com"
custom_domain = true

[[d1_databases]]
binding = "DB"
database_name = "00food"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "PHOTOS"
bucket_name = "00food-photos"

[[durable_objects.bindings]]
name = "FOOD_EVENTS"
class_name = "FoodEventStream"

[[migrations]]
tag = "food-events-v1"
new_sqlite_classes = ["FoodEventStream"]

[[ratelimits]]
name = "SOURCE_LIMITER"
namespace_id = "20101"
  [ratelimits.simple]
  limit = 600
  period = 60

[[ratelimits]]
name = "SIGN_IN_LIMITER"
namespace_id = "20102"
  [ratelimits.simple]
  limit = 20
  period = 60

[[ratelimits]]
name = "TENANT_LIMITER"
namespace_id = "20103"
  [ratelimits.simple]
  limit = 300
  period = 60

[observability]
enabled = true
