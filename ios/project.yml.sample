name: ZeroZeroFood
options:
  bundleIdPrefix: com.example
  deploymentTarget:
    iOS: "27.0"
  createIntermediateGroups: true
settings:
  base:
    SWIFT_VERSION: 5.10
    TARGETED_DEVICE_FAMILY: "1"
    SUPPORTED_PLATFORMS: "iphoneos iphonesimulator"
    SUPPORTS_MACCATALYST: "NO"
    SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD: "NO"
    SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD: "NO"
    MARKETING_VERSION: "1.0"
    CURRENT_PROJECT_VERSION: "1"
    DEVELOPMENT_TEAM: ""
    CODE_SIGN_STYLE: Automatic
targets:
  ZeroZeroFood:
    type: application
    platform: iOS
    sources:
      - path: Sources
        excludes:
          - Widgets/**
          - Watch/**
          - WatchWidgets/**
      - path: Resources/App/Assets.xcassets
      - path: Resources/App/PrivacyInfo.xcprivacy
    info:
      path: Resources/App/Info.plist
      properties:
        CFBundleDisplayName: 00Food
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        FoodPushEnvironment: $(APNS_ENVIRONMENT)
        FoodAppGroup: group.com.example.zerozerofood
        CFBundleURLTypes:
          - CFBundleTypeRole: Editor
            CFBundleURLName: zerozerofood.log
            CFBundleURLSchemes:
              - zerozerofood
        BGTaskSchedulerPermittedIdentifiers:
          - $(PRODUCT_BUNDLE_IDENTIFIER).daily-feedback
        UIBackgroundModes:
          - fetch
          - remote-notification
        FoodServerBaseURL: https://api.example.com
        NSCameraUsageDescription: "00Food uses the camera to capture a meal for an estimate you review."
        NSHealthShareUsageDescription: "00Food reads height, biological sex, resting and active energy, weight, body-fat percentage, and water to show your daily balance and progress. If you request Daily feedback, seven-day Health summaries are sent to your private account for your connected agent to review."
        NSHealthUpdateUsageDescription: "00Food writes new food calories as Dietary Energy when you allow access during setup. It writes water and manually logged weight when you log them. You can choose which Health permissions to grant."
        UIApplicationShortcutItems:
          - UIApplicationShortcutItemType: com.00food.quick-add.log
            UIApplicationShortcutItemTitle: Log food
            UIApplicationShortcutItemIconType: UIApplicationShortcutIconTypeAdd
          - UIApplicationShortcutItemType: com.00food.quick-add.camera
            UIApplicationShortcutItemTitle: Log with camera
            UIApplicationShortcutItemIconType: UIApplicationShortcutIconTypeCapturePhoto
        UISupportedInterfaceOrientations:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        UILaunchScreen: {}
        ITSAppUsesNonExemptEncryption: false
    entitlements:
      path: Resources/App/ZeroZeroFood.entitlements
      properties:
        com.apple.developer.applesignin:
          - Default
        aps-environment: $(APNS_ENVIRONMENT)
        com.apple.developer.healthkit: true
        com.apple.security.application-groups:
          - group.com.example.zerozerofood
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerofood
        APNS_ENVIRONMENT: development
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
        ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME: AccentColor
        TARGETED_DEVICE_FAMILY: "1"
      configs:
        Release:
          APNS_ENVIRONMENT: production
    dependencies:
      - target: ZeroZeroFoodWidgets
        embed: true
      - target: ZeroZeroFoodWatch
        embed: true

  ZeroZeroFoodWidgets:
    type: app-extension
    platform: iOS
    sources:
      - path: Sources/Widgets
      - path: Sources/ActiveDayProgress.swift
      - path: Sources/FoodLogIntent.swift
      - path: Sources/FoodWidgetSnapshot.swift
    info:
      path: Resources/Widgets/Info.plist
      properties:
        CFBundleDisplayName: 00Food
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        FoodAppGroup: group.com.example.zerozerofood
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension
    entitlements:
      path: Resources/Widgets/ZeroZeroFoodWidgets.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerofood
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerofood.widgets
        APPLICATION_EXTENSION_API_ONLY: YES
        TARGETED_DEVICE_FAMILY: "1"
  ZeroZeroFoodWatch:
    type: application
    platform: watchOS
    deploymentTarget: "11.0"
    sources:
      - path: Sources/Watch
      - path: Sources/WatchShared
      - path: Sources/Models.swift
      - path: Sources/ForbesBodyComposition.swift
      - path: Sources/MeasurementUnits.swift
      - path: Sources/ActiveDayProgress.swift
      - path: Resources/Watch/Assets.xcassets
      - path: Resources/App/PrivacyInfo.xcprivacy
    info:
      path: Resources/Watch/Info.plist
      properties:
        CFBundleDisplayName: 00Food
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        WKApplication: true
        WKCompanionAppBundleIdentifier: com.example.zerozerofood
        WKRunsIndependentlyOfCompanionApp: false
        FoodWatchAppGroup: group.com.example.zerozerofood
        CFBundleURLTypes:
          - CFBundleURLName: zerozerofood.watch
            CFBundleURLSchemes:
              - zerozerofoodwatch
        ITSAppUsesNonExemptEncryption: false
    entitlements:
      path: Resources/Watch/ZeroZeroFoodWatch.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerofood
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerofood.watchapp
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
        ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME: AccentColor
        TARGETED_DEVICE_FAMILY: "4"
        SUPPORTED_PLATFORMS: "watchos watchsimulator"
        SDKROOT: watchos
    dependencies:
      - target: ZeroZeroFoodWatchWidgets
        embed: true

  ZeroZeroFoodWatchWidgets:
    type: app-extension
    platform: watchOS
    deploymentTarget: "11.0"
    sources:
      - path: Sources/WatchWidgets
      - path: Sources/WatchShared
      - path: Sources/Models.swift
      - path: Sources/ForbesBodyComposition.swift
      - path: Sources/MeasurementUnits.swift
      - path: Resources/App/PrivacyInfo.xcprivacy
    info:
      path: Resources/WatchWidgets/Info.plist
      properties:
        CFBundleDisplayName: 00Food
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        FoodWatchAppGroup: group.com.example.zerozerofood
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension
    entitlements:
      path: Resources/WatchWidgets/ZeroZeroFoodWatchWidgets.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerofood
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerofood.watchapp.widgets
        APPLICATION_EXTENSION_API_ONLY: YES
        TARGETED_DEVICE_FAMILY: "4"
        SUPPORTED_PLATFORMS: "watchos watchsimulator"
        SDKROOT: watchos

  ZeroZeroFoodTests:
    type: bundle.unit-test
    platform: iOS
    sources:
      - path: Tests
    dependencies:
      - target: ZeroZeroFood
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerofood.tests
        GENERATE_INFOPLIST_FILE: YES
schemes:
  ZeroZeroFood:
    build:
      targets:
        ZeroZeroFood: all
    run:
      config: Debug
    archive:
      config: Release
    test:
      targets:
        - ZeroZeroFoodTests
  ZeroZeroFoodWatch:
    build:
      targets:
        ZeroZeroFoodWatch: all
    run:
      config: Debug
    archive:
      config: Release
